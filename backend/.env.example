# Copy to .env and fill in the values.

# Database (matches docker-compose service name when running in Docker)
DATABASE_URL=postgresql+psycopg://doclens:doclens@db:5432/doclens

# Security — generate a long random string for production
JWT_SECRET=change-me-in-production

# Comma-separated list of allowed frontend origins (browser CORS)
CORS_ORIGINS=http://localhost:3000

# LLM provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=768
